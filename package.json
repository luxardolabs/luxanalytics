{
  "name": "luxanalytics",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "LuxAnalytics - Analytics Event Collector Frontend Assets",
  "scripts": {
    "dev:css": "tailwindcss -i ./app/static/css/tailwind.css -o ./app/static/css/compiled.css --watch",
    "build:css": "NODE_ENV=production tailwindcss -i ./app/static/css/tailwind.css -o ./app/static/css/compiled.css --minify",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.1.0"
  }
}
