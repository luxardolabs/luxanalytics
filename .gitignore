# Secrets: real env files never enter git; .env.example is the committed template
.env
.env.*
!.env.example
# The test suite's compose interpolation values: placeholders only, never a secret
!.env.test
deploy/**/.env*

# Local, untracked overrides (private registry host, prod node)
Makefile.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
build/
dist/
*.egg-info/

# Node (Tailwind build tooling)
node_modules/

# Claude Code: per-user settings and the LuxPM worklist
.claude/settings.local.json
.claude/.luxpm-ledger.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Logs, local databases
*.log
*.db
*.sqlite3

# Stray build artifact (a mis-parsed version path); not source
/1.0/

# Claude Code hook session state (luxarch --emit hooks)
.claude/.hooks-heartbeat
.claude/.luxpm-searched.json
.claude/settings.json.bak
.claude/.push-hold

# Database dumps (make backup / make prod-backup) — production data, never committed
backups/


# Generated by the image's css stage (luxarch --emit css-stage) or make css-watch; never committed
app/static/css/app.css
