# `make test` interpolates compose.yml with this file (TEST_ENV_FILE): compose reads EVERY service,
# so each `${VAR:?}` needs a value even though only the test services start. Placeholders only; the
# suite's own settings come from TEST_ENV in the Makefile. Never put a real secret here.
DEPLOY_ENV=test
REGISTRY=registry.invalid
TAG=local
POSTGRES_PASSWORD=test-only
POSTGRES_VOLUME=luxanalytics_test_unused
REDIS_VOLUME=luxanalytics_test_unused
