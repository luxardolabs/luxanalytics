# Copy to .env.dev / .env.prod and fill in. Real env files are gitignored.
# PostgreSQL container
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database
DATABASE_URL=
DATABASE_URL_SYNC=

# Security
SECRET_KEY=
HMAC_KEYS=

# Redis
REDIS_URL=

# Rate Limiting
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW=
# POST /login per client address, slowapi syntax (default 5/minute)
LOGIN_RATE_LIMIT=
# CIDRs whose X-Forwarded-For is believed (default: loopback + private ranges, i.e. nginx)
TRUSTED_PROXIES=

# Logging
LOG_LEVEL=
LOG_FORMAT=

# App
ENVIRONMENT=
DEBUG=
APP_NAME=

# External URL (for DSN generation; its host is also the default allowed Host header)
EXTERNAL_URL=

# Allowed Host headers (comma list; unset = EXTERNAL_URL host + localhost) and CORS origins
# (comma list or JSON; unset = no cross-origin access). Both fail closed.
ALLOWED_HOSTS=
CORS_ORIGINS=

# Performance
MAX_REQUEST_SIZE=

# Dashboard auth
DASHBOARD_USERNAME=
# REQUIRED: the app refuses to start without it (no default credential)
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TIMEOUT=
