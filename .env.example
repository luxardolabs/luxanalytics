# Copy to .env.dev / .env.prod and fill in. Real env files are gitignored.
# PostgreSQL container
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database
DATABASE_URL=
DATABASE_URL_SYNC=

# Security
SECRET_KEY=
HMAC_KEYS=

# Redis
REDIS_URL=

# Rate Limiting
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW=

# Logging
LOG_LEVEL=
LOG_FORMAT=

# App
ENVIRONMENT=
DEBUG=
APP_NAME=
APP_VERSION=

# External URL (for DSN generation)
EXTERNAL_URL=

# Performance
MAX_REQUEST_SIZE=

# Dashboard auth
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TIMEOUT=
