# The test run's environment (luxarch --emit test-block). Committed: every value is throwaway.
# compose interpolates compose.yml with this file (TEST_ENV_FILE), and the suite's container reads it
# (TEST_ENV's --env-file): docker takes each value as written, so the JSON below needs no quoting.
DEPLOY_ENV=test
COMPOSE_PROFILES=
REGISTRY=test.invalid
TAG=test
POSTGRES_VOLUME=luxanalytics_test_postgres
REDIS_VOLUME=luxanalytics_test_redis
POSTGRES_PASSWORD=test-only
HMAC_KEYS={"test_app": "test-only-hmac-secret"}
