# Local, untracked Make overrides. Copy to `Makefile.local` (gitignored) and fill in your private
# topology — keeping internal hostnames, addresses and credentials out of this public tree:
#
#   cp Makefile.local.example Makefile.local     # then edit the values below
#
# REGISTRY holds this app's local images AND the luxarch / luxlint / luxaudit guard images, so
# `make check` and every guard target need it. EXTERNAL_REGISTRY is where production pulls the
# released image from. PROD_JUMP / PROD_HOST are the ssh jump host and the prod node behind it.
# Without this file `make up` / `make dev` still work; only the registry, guard and prod targets
# need it.
REGISTRY                   ?= docker.your-registry.example:5000
EXTERNAL_REGISTRY          ?= registry.your-domain.example
EXTERNAL_REGISTRY_USER     ?= your-registry-user
EXTERNAL_REGISTRY_PASSWORD ?=
PROD_JUMP                  ?= jump.your-domain.example
PROD_HOST                  ?= root@prod-node.example
# Host directory holding the TLS cert + key the local nginx serves (compose.yml).
TLS_CERTS_DIR              ?= /path/to/your/certs
